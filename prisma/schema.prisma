generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── NextAuth v5 required tables ──────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  githubId      String?   @unique
  accounts      Account[]
  sessions      Session[]
  repos         Repo[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── App tables ───────────────────────────────────────────────────────────────

model Repo {
  id         String   @id @default(cuid())
  userId     String
  repoName   String
  repoOwner  String
  webhookId  Int?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews    Review[]

  @@unique([repoOwner, repoName])
  @@map("repos")
}

model Review {
  id        String        @id @default(cuid())
  repoId    String
  prNumber  Int
  prTitle   String
  status    ReviewStatus  @default(PENDING)
  createdAt DateTime      @default(now())
  repo      Repo          @relation(fields: [repoId], references: [id], onDelete: Cascade)
  issues    ReviewIssue[]

  @@map("reviews")
}

model ReviewIssue {
  id         String   @id @default(cuid())
  reviewId   String
  file       String
  line       Int?
  severity   Severity
  message    String   @db.Text
  suggestion String?  @db.Text
  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_issues")
}

enum ReviewStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum Severity {
  CRITICAL
  WARNING
  SUGGESTION
}
